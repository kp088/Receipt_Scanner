EXTRACTOR=mock

# Only needed when EXTRACTOR=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Only needed when EXTRACTOR=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Any SQLAlchemy URL works here, e.g. postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./receipts.db

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# Fill a new, empty database with a few sample receipts (true or false)
SEED_SAMPLE_DATA=true
